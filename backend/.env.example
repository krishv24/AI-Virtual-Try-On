# ==========================================
# AI Virtual Try-On Backend Configuration
# ==========================================

# Server Host & Port
HOST=127.0.0.1
PORT=8000
DEBUG=True

# CORS Configuration (Allows Chrome Extension origins & local dev)
CORS_ORIGINS=["*"]

# Database (SQLite default for initial setup)
DATABASE_URL=sqlite:///./tryon.db

# ==========================================
# AI Model Services & Inference (Free Tiers Only)
# ==========================================

# Hugging Face Spaces (ZeroGPU) - CatVTON / IDM-VTON self-hosted spaces
HF_TOKEN=
HF_CATVTON_SPACE_URL=

# Free-Tier Styling Text & Recommendations (Groq OR Google Gemini Free Tier)
# Note: Zero OpenAI / Anthropic paid usage
GROQ_API_KEY=
GEMINI_API_KEY=
